    {
     "type": "WEB",
     "url": "https://github.com/openbabel/openbabel/security/advisories/GHSA-55f6-pf8r-c2f4"
    }
   ],
   "summary": "Open Babel has out-of-bounds write in MOPAC translationVectors[] (UNIT CELL TRANSLATION)"
  }

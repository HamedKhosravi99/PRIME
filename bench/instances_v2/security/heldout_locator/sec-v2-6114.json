   "severity": [
    {
     "score": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N"
    }
   ],
   "summary": "collective.contact.widget is vulnerable to cross-site scripting "
  }

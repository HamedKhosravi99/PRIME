   "severity": [
    {
     "score": "CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N"
    }
   ],
   "summary": "Vantage6: No limit on emails sent for password/MFA reset"
  }

 "records": {
  "NCT04285476": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "The aim is to validate a signature of microRNA (micro Ribonucleic acid) based in a first exploratory study allowing the stratification of the cytologies of indeterminate type and to study and select others. In a first step, the teams will focus on standardising the pre-analytical stages and defining a threshold of positivity. The results of microRNA signature on a cohort of 70 patients will be compared with the ultrasound and then histological data of the resection specimen."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n1. Man or woman whose Age is \u2265 18 years\n2. Patient requiring ultrasound for thyroid nodule scanning with established indication of FNAC\n3. Patient with Bethesda 3, 4 and 5 thyroid nodule\n4. Informed patient and signed informed consent received\n5. Patient affiliated to a French medical coverage system\n\nExclusion Criteria:\n\n1. Patient under guardianship, curatorship or safeguarding of justice\n2. Patient whose medical or psychological conditions do not permit them to complete the study or to sign the consent,\n3. Patient with metastatic cancer distinct from thyroid cancer\n4. Patient who has stopped treatment (chemotherapy / immunotherapy) for cancer for less than 6 months.",
     "healthyVolunteers": false
    },

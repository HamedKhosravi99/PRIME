 "records": {
  "NCT01646502": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "Chronic wounds cause significant morbidity and cost our healthcare system millions of dollars each year.Their healing is slowed by biofilms, communities of bacteria surrounded by a protective layer that stops the immune system and antibiotics from getting close enough to kill them. The investigators will develop a new strategy to destroy biofilms using a protein made from bacteria that live on our skin.The Staphylococcus epidermidis Esp protein will be used to destroy Staphylococcus aureus biofilms, the most common bacterium in chronic wounds. The investigators hypothesize that the use of the Esp protein will breakdown S. aureus biofilms, decrease bacterial colonization of chronic wounds and improve healing times."
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n1. Have a leg ulcer with the ankle brachial pressure index (ABPI) equal or greater than 0.6;\n2. Have a wound that is 15 cm or less in diameter;\n3. Are 19 years or older;\n4. Have no known contraindication to the treatment products\n\nExclusion Criteria:\n\n1. Have a leg ulcer caused by pressure, diabetes, ischemia, inflammatory disorder, hematologic disorder or malignancy\n2. Have applied an antiseptic to the wound in the one week prior to recruitment\n3. Have received systemic or topical antibiotic therapy within 48 hours prior to recruitment\n4. Are being treated with systemic steroids (prednisone)",
     "healthyVolunteers": false,
     "minimumAge": "19 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "nctId": "NCT01646502"
    },
    "statusModule": {
     "studyFirstSubmitDate": "2012-07-18"
    }
   }
  }
 },

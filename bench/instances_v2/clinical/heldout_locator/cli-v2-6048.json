 "records": {
  "NCT07159256": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "Stroke rehabilitation programs are traditionally designed based on the evaluation of motor and sensory impairments starting from the acute phase. Although studies in diseases such as multiple sclerosis and Parkinson's disease have shown that information processing speed may affect motor function and balance, no such study has been conducted in stroke patients.\n\nThis study aims to investigate the effect of information processing speed on motor function, balance, gait, and quality of life in patients with ischemic stroke."
    },
    "designModule": {
     "studyType": "OBSERVATIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Age 40 years or older\n* First-ever ischemic stroke\n* Hemodynamically stable\n* Able to read and write (literate)\n* No history of psychiatric, neurological, visual, auditory, or orthopedic conditions prior to stroke that could affect mobilization\n* After stroke, full scores in the vision and speech domains according to the NIH Stroke Scale (NIHSS)\n\nExclusion Criteria:\n\n* Recurrent stroke\n* Post-stroke visual or hearing impairment\n* Neglect\n* Aphasia\n* Conditions causing impaired consciousness such as dementia, confusion, or delirium\n* Presence of cardiovascular or orthopedic conditions after stroke that prevent mobilization\n* Age 75 years or older",
     "healthyVolunteers": false,
     "minimumAge": "40 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Impact of Processing Speed on Motor, Balance, Gait, and Quality of Life in Stroke\"",
     "nctId": "NCT07159256",
     "officialTitle": "The Effect of Information Processing Speed on Motor Function, Balance, Gait, and Quality of Life in Patients With Ischemic Stroke"
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2025-09-05",
     "overallStatus": "ENROLLING_BY_INVITATION",
     "statusVerifiedDate": "2025-09"
    }
   }
  }
 },

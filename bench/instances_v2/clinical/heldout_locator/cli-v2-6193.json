 "records": {
  "NCT06927154": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "The study compares Facet Oscillatory Mobilization and Mobilization with Movement in managing chronic mechanical neck pain, aiming to determine the effectiveness of these techniques in pain, range of motion, and disability."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* complaint of Chronic Mechanical neck pain ( more than 6 weeks).\n* Neck Disability Index (NDI) score more than 16%\n* Age between 35-45 years, Both Male and Female\n* NPRS score more than 3-6.\n* Recurrent neck pain aggravated at least once in the month.\n* Painful Cervical ROM (Flexion less than 80, Extension less than 70, rotation less than 90 to both sides and lateral flexion less than 35 degree.\n\nExclusion Criteria:\n\n* Cervical radiculopathy\n* Cervical canal stenosis\n* Severe neurological disorder\n* Previous cervical surgery\n* Recent history of fall/trauma to the cervical spine.",
     "minimumAge": "35 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Comparison of Facet Oscillatory Mobilization and Mobilization With Movement in Chronic Mechanical Neck Pain",
     "nctId": "NCT06927154",
     "officialTitle": "Comparison of Facet Oscillatory Mobilization and Mobilization With Movement in Chronic Mechanical Neck Pain"
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2026-04-02",
     "overallStatus": "COMPLETED",
     "statusVerifiedDate": "2026-04",
     "studyFirstSubmitDate": "2025-04-07"
    }
   }

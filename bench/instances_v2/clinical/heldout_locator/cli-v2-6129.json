  "NCT00705354": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "This study will compare the incidence of post-op infection after sinus surgery using conventional post-op oral antibiotics to the incidence of infection after sinus surgery when a bio-resorbable antibiotic soaked nasal sponge is used in the nasal cavity in lieu of post-op oral antibiotics. The nasal sponge is a routine nasal dressing used after sinus surgery and will therefore be placed in all patients."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },

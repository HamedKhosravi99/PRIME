 "records": {
  "NCT01857518": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "Adolescence is a critical period for the development of depressive disorders. As adolescence also is a critical period for brain maturation, it may be hypothesized that maturation changes in emotional circuits could underlie vulnerability for depression.\n\nThe aims of the study are (1) to identify the changes in brain morphometry, white matter microstructure, and functioning, in networks associated with depression features in adolescents, and (2) to assess the effects of treated pathology on brain structure by comparing the neuroimaging measures obtained in adolescents at inclusion with those at follow-up."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\nDepressed adolescents:\n\nTeenagers of both sexes, from 15 to 18 years old, without contreindications in magnetic fields\n\n* affiliation to a Social insurance\n* Informed consent signed by the holders of the parental rights (a specific information note to the teenager)\n* Diagnosis DSM-IV-TR ( 2000 ) of depressive Disorder of the humor without psychotic characteristics. The symptoms will have to be persistent for 3 weeks, in spite of a coverage of support ( 2 consultations).\n\nExclusion Criteria:\n\n* Ferromagnetical Material in the body\n* Claustrophobia, Syndrom of post-traumatic stress, Obsessive-compulsive Disorder, Disturb Tricks, Disturbs abuse of substances\n* Intrusive disorder of the development, Disturbs hyperactivity deficit of the attention, Disorders of the conducts, Schizophrenia\n* Current antidepressant or antipsychotic psychotropic Treatment for more than 15 days in effective doses\n* Current somatic pathology, or pregnancy (urinary test of pregnancy in case of doubt)\n* Histories of cranial trauma or neurological pathology, or of lower born weight in 800g\n* History of electroconvulsivotherapy in the previous 6 months\n* Refusal to give his(her) consent or to be revised on one year after inclusion\n\nHealthy adolescents: will be screened to be matched to the patients according to age and sex. They will have no psychiatric diagnosis, and no family history of psychiatric conditions.",
     "healthyVolunteers": true,
     "minimumAge": "15 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Depression in Adolescents. A Cerebral Structural, Diffusion, and Functional Magnetic Resonance Imaging Study",
     "nctId": "NCT01857518",
     "officialTitle": "Depression in Adolescents. A Cerebral Structural, Diffusion, and Functional Magnetic Resonance Imaging Study."
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2017-10-18",
     "overallStatus": "UNKNOWN",
     "statusVerifiedDate": "2017-10",
     "studyFirstSubmitDate": "2013-05-16"
    }
   }
  }

 "records": {
  "NCT03330288": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "The main purpose of this study is to evaluate how a long-term treatment with Theraflex during 64 weeks affects pain intensity in the affected knee or hip joint, the activity in daily living, the quality of life and patient satisfaction with treatment."
    },
    "designModule": {
     "studyType": "OBSERVATIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Patients 45 to 75 years with Hip or Knee OA stage I to III\n* Patient started current treatment with Theraflex not more than 2 weeks prior to inclusion into the study\n* Personally signed and dated informed consent\n\nExclusion Criteria:\n\n* Patients participating in an investigational program with interventions outside of routine clinical practice\n* Patients with Hip or Knee OA stage 0 or stage IV\n* Patients who have both Hip and Knee OA and OA of any other location\n* Contraindications for use of Theraflex in accordance with approved label(known hypersensitivity, severe chronic renal failure)\n* Females who are pregnant or breastfeeding\n* Patients who completed a treatment with Theraflex or another combination of Gl+ Ch less than 5 months before start of the current treatment\n* Patients who completed intra-articular corticosteroids treatment in the last 3 months to exclusion criteria\n* Patients who completed hyaluronic injections of the lower limbs in the last 6 months",
     "healthyVolunteers": false,
     "minimumAge": "45 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Prospective Multicenter Non-interventional Study in Patients With Knee or Hip Osteoarthritis Having a Theraflex Treatment",
     "nctId": "NCT03330288",
     "officialTitle": "Prospective Multicenter Non-interventional Study in Patients With Knee or Hip Osteoarthritis Having a Theraflex\u00ae Treatment to Evaluate Changes in Pain, Functions in Daily Living, and Quality of Life for an Observation Period up to 64 Weeks"
    },
    "statusModule": {
     "overallStatus": "COMPLETED",
     "statusVerifiedDate": "2021-09",
     "studyFirstSubmitDate": "2017-10-06"
    }
   }
  }
 },

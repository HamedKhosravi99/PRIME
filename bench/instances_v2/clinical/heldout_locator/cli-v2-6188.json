 "records": {
  "NCT05410990": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "All consecutive patients admitted to the intensive care unit (ICU) with ADHF between January 2017 and December 2021 were enrolled in this retrospective study. All-cause mortality and MACE were assessed with respect to relationships with eosinophil indices, including neutrophil-to-eosinophil ratio (NER), leukocyte-to-eosinophil ratio (LER), eosinophil-to-lymphocyte ratio (ELR), and eosinophil-to-monocyte ratio (EMR)."
    },
    "designModule": {
     "studyType": "OBSERVATIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* patients who admitted to the intensive care unit (ICU) with Acute Decompensated Heart Failure and reduced Ejection Fraction (\\<%40)\n\nExclusion Criteria:\n\n* Patients with an LVEF \\>40%, NYHA Class I and II subjects, those with advanced liver, kidney diseases or malignancies, patients in whom life expectancy was extremely short and patients with autoimmune, allergic, or infectious diseases",
     "minimumAge": "18 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Eosinophil Indices in Patients With Acute Heart Failure",
     "nctId": "NCT05410990",
     "officialTitle": "Predictive Value of Eosinophil Indices for Major Cardiovascular Events in Patients With Acute Heart Failure"
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2022-06-06",
     "overallStatus": "COMPLETED",
     "statusVerifiedDate": "2022-06",
     "studyFirstSubmitDate": "2022-06-06"
    }
   }
  }

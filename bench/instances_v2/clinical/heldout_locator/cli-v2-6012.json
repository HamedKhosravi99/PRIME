   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "A randomized controlled study comparing the effect of administration of 1 gm ceftriaxone in elective cesarean section 30-60 min before skin incision versus after cord clamping."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Patients undergoing elective cesarean section with Gestational age 37 weeks or more\n\nExclusion Criteria:\n\n1. Fever greater than 38\u00b0C or maternal sepsis.\n2. Cephalosporin allergy.\n3. Exposure to any antibiotic agent within 1week before delivery.\n4. Patents having premature rupture of membranes and acute chorioamnionitis.\n5. Patients with chronic diseases (diabetes mellitus, renal disease and Cardiac disease).\n\n3\\) Morbid obesity (BMI\\>30)",
     "healthyVolunteers": false,
     "minimumAge": "18 Years",
     "sex": "FEMALE"
    },

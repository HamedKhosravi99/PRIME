 "records": {
  "NCT05014256": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "This project will study how kidney care for everyone despite race can reduce racial differences in care and improve access to kidney transplants, and specifically living donor kidney transplants (LDKT), for individuals with chronic kidney disease. A study focused on equality and patient needs (called 'STEPS') will 1) create a program to identify people who may need a kidney transplant ('STEPS Surveillance') and find people in health systems who may be able to receive kidney transplants early in their care and (2) study how well the 'STEPS Outreach' program works (comprised of transplant social workers and transplant coordinators who focus on equality and patient needs) compared to usual care to improve access to kidney transplants among Black and non-Black individuals as well as to improve access to transplants for everyone."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Ability to provide oral informed consent\n* Male or female, aged 18 to \\<=75 years\n* Presence of CKD (2 eGFRs \\<60, 90 days apart) and at least 1 of the following: most recent eGFR less than 30 or KFRE greater than 10%\n* English speaking with adequate ability to hear and understand questions over the phone\n* Willing to comply with all study procedures and be available for the duration of the study\n\nExclusion Criteria:\n\n* Male or female, aged \\<18 or \\> 75 years\n* Non-English speaking\n* Lack of ability to hear and comprehend verbal communication.\n* Patients on dialysis\n* Deceased\n* Hospice/palliative care\n* Prior kidney transplant\n* Currently waitlisted at any transplant center\n* Self-reported terminal illness or receipt of hospice services",
     "healthyVolunteers": false,
     "minimumAge": "18 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "System Interventions to Achieve Early and Equitable Transplants (STEPS) Study",
     "nctId": "NCT05014256",
     "officialTitle": "System Interventions to Achieve Early and Equitable Transplants (STEPS) Study"
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2026-01-27",
     "overallStatus": "COMPLETED",
     "statusVerifiedDate": "2025-09",
     "studyFirstSubmitDate": "2021-08-13"
    }
   }
  }
 },

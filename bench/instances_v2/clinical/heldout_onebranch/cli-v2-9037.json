   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "The study hypothesis is that liver transplantation after selective internal radiation therapy (SIRT) and chemotherapy would improve 3-year overall survival in patients with locally advanced (unresectable but non-metastatic) intrahepatic cholangiocarcinoma.\n\nIt is planned to include 36 patients with locally advanced intrahepatic cholangiocarcinoma, not eligible for initial surgery and without metastases. Participants will be recruited from care facilities in France."
    },

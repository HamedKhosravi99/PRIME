    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Being over 18 years old and female\n* Can communicate\n* Being a primary caregiver family member of cancer patients receiving treatment,\n* Providing care to the patient for 8 hours / day for at least 6 months, and Caregiver Stress Scale (CSS) score of 7 and above\n\nExclusion Criteria:\n\n* To provide maintenance service for a fee,\n* Having another medical problem that will prevent pulse rate and blood pressure measurement,\n* Pulse rate to be variable,\n* Being unable to give a saliva secretion due to other medical problems,\n* Using cortisol and its derivative drugs,\n* Having a history of psychiatric disorders,\n* Being a Reiki practitioner or trainer,\n* To have received energy therapies such as Reiki / Therapeutic touch / Healing touch,\n* To use other complementary and integrated medicine applications",
     "minimumAge": "18 Years"
    },
    "identificationModule": {
     "briefTitle": "The Effect of Reiki on the Stress Level of Caregivers of Cancer Patients",
     "nctId": "NCT04461873",
     "officialTitle": "The Effect of Reiki on the Stress Level of Caregivers of Cancer Patients: Qualitative and Single-blind Randomized Controlled Trial"
    },
    "statusModule": {
     "statusVerifiedDate": "2020-07"
    }
   }
  }

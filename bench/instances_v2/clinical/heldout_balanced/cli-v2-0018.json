 "records": {
  "NCT06222346": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "Over 15 million people in England live with a long-term physical health condition. Low mood, loneliness and worry related to chronic illness are very common. In partnership with people with long-term conditions we have co-designed an online peer support platform to help people with health problems connect, support others, share experiences, and receive evidence-based information and advice on self-management.\n\nThis study explores if the platform is feasible to implement and acceptable for people with long-term conditions experiencing mild depressive symptoms. Those allocated to the intervention arm will be invited to try out an online peer support platform with psychoeducational resources named \"CommonGround\". Those in the control arm will be guided to use the National Health Service NHS \"Mental Health\" webpages."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "minimumAge": "18 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "nctId": "NCT06222346",
     "officialTitle": "Online Peer Support in Long-term Conditions: a Feasibility Randomised Controlled Trial"
    },
    "statusModule": {
     "statusVerifiedDate": "2024-07"
    }
   }
  }

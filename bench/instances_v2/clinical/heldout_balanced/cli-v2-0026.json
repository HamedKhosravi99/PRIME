 "records": {
  "NCT03068494": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "The COBIS III registry is a multi-center, real-world registry of 2nd generation drug-eluting stenting in coronary bifurcation lesions in South Korea. From 21 major coronary intervention centers in Korea, a total of 3,000 patients (anticipated) will be enrolled in this database between January 2010 and December 2014.\n\nThe aim of the study was to investigate long-term clinical results and predictors of adverse outcomes after percutaneous coronary intervention with 2nd generation drug-eluting stents for coronary bifurcation lesions in South Korea."
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Age \\>=19 years\n* Any type of de novo bifurcation lesion in major epicardial artery: unprotected left main coronary bifurcation lesion, LAD - diagonal, LCX-OM, distal RCA bifurcation. (Excluding RCA-RV branch bifurcation, branch bifurcation)\n* Side branch or LCX reference diameter \\>= 2.3 mm and at least stentable with 2.5 mm stent\n* Treated with drug-eluting stent during the period of 2010. 1 \\~ 2014. 12\n\nExclusion Criteria:\n\n* Protected left main disease previous CABG for LAD or LCX territory\n* Cardiogenic Shock\n* History of CPR in the same hospitalization\n* Patients with severe left ventricular systolic dysfunction (ejection fraction \\< 30%)",
     "healthyVolunteers": false,
     "sex": "ALL"
    },
    "identificationModule": {
     "officialTitle": "Multicenter, Retrospective Korean Coronary Bifurcation Stenting (COBIS) Registry III"
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2019-05-06",
     "overallStatus": "COMPLETED"
    }
   }
  }
 },

   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "We would like to quantify the amount and type of activity a typical pregnant woman engages in and then compare the pregnancy outcomes of women with varying activity levels. To do this, we will have women wear a device known as an accelerometer (that records activity by measuring changes in voltage levels) at certain times in their pregnancies."
    },
    "designModule": {
     "studyType": "OBSERVATIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Nulliparous\n* First trimester (11-14w)\n* No medical contraindications to normal activity\n\nExclusion Criteria:\n\n* Chronic medical conditions that require restricted activity (cardiac disease, severe asthma, etc)\n* Known fetal anomalies\n* Morbid obesity (BMI \\> 39)\n* Maternal age less than 18 years\n* Inability to comply with instructions",
     "healthyVolunteers": false,
     "minimumAge": "18 Years"
    },

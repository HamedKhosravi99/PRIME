  "resultsSection": {
    "adverseEventsModule": {
      "description": "All-Cause Mortality (ACM) includes all randomized participants. AEs include all randomized participants who received \u22651 dose of study treatment. Progression of the cancer under study was not considered an AE unless related to study drug. MedDRA preferred terms \"Neoplasm progression\", \"Malignant neoplasm progression\" and \"Disease progression\" not related to study drug are excluded as AEs. Data are reported by treatment received. ACM and AEs are reported separately for pembrolizumab second course.",
      "eventGroups": [
        {
          "deathsNumAffected": 178,
          "deathsNumAtRisk": 251,
          "description": "Participants received pembrolizumab 200 mg via IV infusion on Day 1 of each 21-day cycle for up to 35 cycles (up to approximately 2 years) PLUS lenvatinib 20 mg via oral capsule QD until PD or discontinuation. With protocol amendment 3 (effective: Sep-24-2021), participants discontinued lenvatinib.",
          "id": "EG000",
          "otherNumAffected": 238,
          "otherNumAtRisk": 247,
          "seriousNumAffected": 155,
          "seriousNumAtRisk": 247,
          "title": "Lenvatinib + Pembrolizumab First Course"
        },
        {
          "deathsNumAffected": 175,
          "deathsNumAtRisk": 254,
          "description": "Participants received pembrolizumab 200 mg via IV infusion on Day 1 of each 21-day cycle for up to 35 cycles (up to approximately 2 years) PLUS placebo for lenvatinib via oral capsule QD until PD or discontinuation.\n\nWith protocol amendment 3 (effective: Sep-24-2021), participants discontinued placebo.",
          "id": "EG001",
          "otherNumAffected": 236,
          "otherNumAtRisk": 254,
          "seriousNumAffected": 116,
          "seriousNumAtRisk": 254,
          "title": "Placebo + Pembrolizumab First Course"
        },
        {
          "deathsNumAffected": 0,
          "deathsNumAtRisk": 2,
          "description": "At the investigator's discretion, eligible participants randomized to the pembrolizumab PLUS lenvatinib arm who completed the first course of pembrolizumab, or who had stopped pembrolizumab due to confirmed CR, initiated a second course of pembrolizumab (200 mg IV infusion on Day 1 of each 21-day cycle, for up to 17 cycles \\[up to approximately 1 additional year\\]) upon experiencing PD.",
          "id": "EG002",
          "otherNumAffected": 1,
          "otherNumAtRisk": 2,
          "seriousNumAffected": 0,
          "seriousNumAtRisk": 2,
          "title": "Lenvatinib + Pembrolizumab \u2192 Pembrolizumab Second Course"
        },
        {
          "deathsNumAffected": 0,
          "deathsNumAtRisk": 5,
          "description": "At the investigator's discretion, eligible participants randomized to the pembrolizumab PLUS placebo arm who completed the first course of pembrolizumab, or who had stopped pembrolizumab due to confirmed CR, initiated a second course of pembrolizumab (200 mg IV infusion on Day 1 of each 21-day cycle, for up to 17 cycles \\[up to approximately 1 additional year\\]) upon experiencing PD.",
          "id": "EG003",
          "otherNumAffected": 5,
          "otherNumAtRisk": 5,
          "seriousNumAffected": 0,
          "seriousNumAtRisk": 5,
          "title": "Placebo + Pembrolizumab \u2192 Pembrolizumab Second Course"
        }
      ],

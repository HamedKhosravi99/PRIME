  "protocolSection": {
    "armsInterventionsModule": {
      "armGroups": [
        {
          "description": "Participants receive pembrolizumab 200 mg via intravenous (IV) infusion on Day 1 of each 21-day cycle for up to 35 cycles (up to \\~2 years) PLUS lenvatinib 20 mg via oral capsule once daily (QD) until progressive disease or discontinuation. With protocol amendment 3 (effective: Sep-24-2021), participants discontinue lenvatinib.",
          "interventionNames": [
            "Biological: Pembrolizumab",
            "Drug: Lenvatinib"
          ],
          "label": "Pembrolizumab + Lenvatinib",
          "type": "EXPERIMENTAL"
        },
        {
          "description": "Participants receive pembrolizumab 200 mg via IV infusion on Day 1 of each 21-day cycle for up to 35 cycles (up to \\~2 years) PLUS placebo for lenvatinib via oral capsule QD until progressive disease or discontinuation. With protocol amendment 3 (effective: Sep-24-2021), participants discontinue placebo.",
          "interventionNames": [
            "Biological: Pembrolizumab",
            "Drug: Placebo for lenvatinib"
          ],
          "label": "Pembrolizumab + Placebo",
          "type": "ACTIVE_COMPARATOR"
        }
      ],
      "interventions": [
        {
          "armGroupLabels": [
            "Pembrolizumab + Lenvatinib",
            "Pembrolizumab + Placebo"
          ],
          "description": "IV infusion",
          "name": "Pembrolizumab",
          "otherNames": [
            "MK-3475",
            "KEYTRUDA\u00ae"
          ],
          "type": "BIOLOGICAL"
        },
        {

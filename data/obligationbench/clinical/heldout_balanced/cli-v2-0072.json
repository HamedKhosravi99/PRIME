  "NCT07060105": {
   "protocolSection": {
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n1. Age 8-17\n2. Blunt head injury within the past five days with any associated symptoms as outlined in the concussion inventory.\n3. English or Spanish speaking.\n4. Glasgow Coma Scale score of 13-15\n5. Treating provider plans to use saline administration as part of patient's treatment plan\n\nExclusion Criteria:\n\n1. Intracranial injury diagnosed by CT / MR Brain, though imaging is not a requirement for this study.\n2. Possible or witnessed posttraumatic seizure\n3. Developmental delay / intellectual disability\n4. Underlying cardiac, pulmonary, and renal pathology in which fluid administration or hypertonic saline may potentially be harmful, based on attending provider judgement.\n5. Suspected use of alcohol or illicit substances\n6. Associated injuries requiring the use of narcotics for analgesia",
     "healthyVolunteers": false,
     "minimumAge": "8 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Hypertonic Saline for Mild TBI in Pediatric Patients"
    },
    "statusModule": {
     "statusVerifiedDate": "2025-07"
    }
   }
  }

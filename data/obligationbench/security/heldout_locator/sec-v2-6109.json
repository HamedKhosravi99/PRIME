    }
   ],
   "schema_version": "1.7.3",
   "severity": [
    {
     "score": "CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H"
    }
   ],
   "summary": "LlamaIndex vulnerable to DoS attack through uncontrolled recursive JSON parsing"
  }

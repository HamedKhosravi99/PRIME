   "severity": [
    {
     "score": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:L"
    }
   ],
   "summary": "PyBlade: SSTI/RCE via Bypassed AST Validation in sandbox.py"
  }

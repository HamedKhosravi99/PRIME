     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion criteria\n\n* Male or female, adults aged between 16 and 65 years.\n* Planning to travel to the forest within the next 72 hours and stay overnight.\n* Written informed consent.\n* Willingness and ability of the participants to comply with the study protocol for the duration of the study.\n\nExclusion criteria\n\n* For females: known pregnancy or breast feeding\n* Participants who have received artemisinin or a derivative or an artemisinin-containing combination therapy (ACT) within the previous 7 days.\n* History of allergy or known contraindication to artemisinins, lumefantrine or multivitamins\n* Documented or claimed history of cardiac conduction problems\n* Severe vomiting or diarrhoea\n* Signs/symptoms of clinical malaria (febrile or history of fever in the previous 24 hours) confirmed by RDT.",
     "minimumAge": "16 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "nctId": "NCT04041973",
     "officialTitle": "An Open-label Individually Randomised Controlled Trial to Assess the Efficacy of Artemether-lumefantrine Prophylaxis for Malaria Among Forest Goers in Cambodia"
    },
    "statusModule": {
     "statusVerifiedDate": "2022-05"
    }

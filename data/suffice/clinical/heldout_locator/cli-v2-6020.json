  "NCT03276910": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "The main objective of this research is to demonstrate the possible use of erythroferrone (ERFE) as a potential marker of recombinant human erythropoietin (rHuEpo) use to be included in the Athlete Biological Passport (PBA) developed by the World Anti-Doping Agency (WADA)."
    },
    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Man between 18 and 49 years old\n* Beneficiary of a social protection scheme\n* Able to sign informed consent\n\nExclusion Criteria:\n\n* Hematocrite\\>50% or Hemoglobin\\> 17d/dl or Ferritin\\<30 ug/l\n* Hypersensitivity to the active substance or to any of the excipients ofEPREX\n* Erythroblastopenia already reported following treatment with erythropoietin\n* Uncontrolled hypertension\n* Any medication taken as part of a chronic treatment\n* Absence of stable or evolutionary pathology without treatment\n* History of convulsion or epilepsy\n* History of thrombotic vascular events\n* Large blood loss due to an accident, pathological condition or other similar situation.\n* Donation of blood or blood transfusion within three months prior to inclusion in the protocol.",
     "healthyVolunteers": true,
     "minimumAge": "18 Years",
     "sex": "MALE"
    },
    "identificationModule": {
     "briefTitle": "Evaluation of Erythroferrone as a New Biomarker of Erythropoesis Stimulating Agents",
     "nctId": "NCT03276910",
     "officialTitle": "Evaluation of Erythroferrone as a New Biomarker of Erythropoesis Stimulating Agents"
    },

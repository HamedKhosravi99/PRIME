 "records": {
  "NCT03781037": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "This study will develop and pilot test a novel intervention module targeting perceived burdensomeness toward others in 30 clinic referred youths who experience anxiety or depression and elevated levels of burdensomeness. All participants will be assigned to receive the intervention in this open trial."
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* Clinical diagnosis of an anxiety disorder, persistent depressive disorder, or major depressive disorder\n* Score \\> 4 on the youth self-report Interpersonal Needs Questionnaire- Perceived Burdensomeness Scale\n\nExclusion Criteria:\n\n* Clinical diagnosis of a Psychotic Disorder, Autism Spectrum Disorder or Intellectual Disability\n* Show high risk of imminent self-injurious behaviors\n* Be involved currently in another behavioral treatment\n* Not live with a primary caregiver who is legally able to give consent for the youth's participation\n* Be a victim of previously undisclosed abuse requiring investigation or ongoing supervision by the Department of Children and Families.",
     "healthyVolunteers": false,
     "minimumAge": "10 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Targeting Burdensomeness Among Clinic Referred Youth",
     "nctId": "NCT03781037"
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2021-05-12",
     "overallStatus": "COMPLETED",
     "statusVerifiedDate": "2021-05"
    }
   }

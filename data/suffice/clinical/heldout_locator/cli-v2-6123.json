 "records": {
  "NCT01614340": {
   "protocolSection": {
    "descriptionModule": {
     "briefSummary": "The overall goal of this real-world comparative effectiveness research (CER) study is to reduce disability among older home health patients by treating their pain more effectively. To achieve this goal the investigators will conduct a cluster randomized controlled trial of a physical therapist (PT) delivered intervention provided to VNSNY home health care patients with activity-limiting pain. The intervention is an evidence-based non-pharmacological program to reduce pain and pain-related disability that utilizes cognitive-behavioral pain self-management (CBPSM) techniques."
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* VNSNY patient in the adult home healthcare program\n* Services are being provided in the Bronx, Brooklyn, Manhattan, Queens, Staten Island, Nassau or Westchester\n* VNSNY Plan of Care includes physical therapy\n* Age 55 or older\n* Speaks English\n* Has a telephone\n* Activity-limiting pain\n\nExclusion Criteria:\n\n* Significant cognitive impairment",
     "minimumAge": "55 Years",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "Treating Pain to Reduce Disability Among Older Home Health Patients",
     "nctId": "NCT01614340",
     "officialTitle": "Treating Pain to Reduce Disability Among Older Home Health Patients"
    },
    "statusModule": {
     "overallStatus": "COMPLETED",
     "statusVerifiedDate": "2018-08"
    }
   }
  }
 },

    "designModule": {
     "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
     "eligibilityCriteria": "Inclusion Criteria:\n\n* adult patients at least 18 years of age\n* CHC infection, genotype 1\n* unable to tolerate or not responsive to PEG-Intron + ribavirin therapy after 12 weeks of treatment\n* use of 2 forms of contraception during the study in both men and women\n\nExclusion Criteria:\n\n* women who are pregnant or breast-feeding\n* medical condition associated with chronic liver disease (eg, hemochromatosis, autoimmune hepatitis, alcoholic liver disease, toxin exposures)\n* patients with decompensated cirrhosis\n* patients receiving any systemic antiviral therapy or investigational drug, other than PEG-Intron + ribavirin, 24 weeks prior to the first dose of study drug",
     "sex": "ALL"
    },
    "identificationModule": {
     "briefTitle": "A Study of PEGASYS (Peginterferon Alfa-2a (40KD)) in Combination With Ribavirin in Patients With Chronic Hepatitis C (CHC) Previously Treated With PEG-Intron + Ribavirin",
     "officialTitle": "An Open-label, Multicenter, Efficacy and Safety Study of Pegasys\u00ae Plus Ribavirin in Patients With Chronic HCV Infection Who Are Unable to Tolerate or Who Do Not Respond to 12 Weeks of Therapy With PEGIntron \u00ae Plus Ribavirin"
    },
    "statusModule": {
     "lastUpdateSubmitDate": "2016-05-02",
